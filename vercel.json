{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "redirects": [
    { "source": "/keeper/:path*", "destination": "/", "permanent": false },
    { "source": "/contracts/:path*", "destination": "/", "permanent": false },
    { "source": "/package.json", "destination": "/", "permanent": false },
    { "source": "/vercel.json", "destination": "/", "permanent": false }
  ],
  "crons": [
    { "path": "/api/keeper", "schedule": "* * * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
