# Paste after launching on Pons V2 (ponsfamily.com)
TOKEN_ADDRESS=0x
VAULT_ADDRESS=0x
PRIVATE_KEY=0x
VAULT_DEPLOYMENT_BLOCK=
# Token's Pons bonding curve — enables keeper fee sweeps pre-graduation (optional)
CURVE_ADDRESS=0x
# Pons V2 fee escrow on Robinhood Chain (default is already correct)
FEE_ESCROW_ADDRESS=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# Optional anti-scam allowlist: comma-separated wallets. When set, ONLY these
# wallets can win draws, with balances verified directly on-chain.
# ALLOWLIST=0xabc...,0xdef...
